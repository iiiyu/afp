<Layouts.app flash={@flash}>
  <section class="rounded border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
    <h1 class="text-xl font-semibold">App Factory Control Plane</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
      Local-first portfolio command center for lifecycle state, Codex session visibility,
      release readiness, evidence, and business posture.
    </p>
    <.link
      navigate={~p"/today"}
      class="mt-4 inline-flex items-center gap-2 rounded border border-slate-950 bg-slate-950 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800 dark:border-white dark:bg-white dark:text-slate-950"
    >
      <.icon name="hero-bolt" class="size-4" /> Open Today
    </.link>
  </section>
</Layouts.app>
